# ── GX-Arc Backend Environment ──
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# Server
PORT=4000

# SMTP credentials (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-app-password

# Recipient — all form submissions are delivered here
RECIPIENT_EMAIL=your-team-email@example.com

# CORS — comma-separated origins allowed to call the API
# Same-origin requests (frontend served by same server) work without this.
# Set only if you need cross-origin access.
ALLOWED_ORIGINS=
